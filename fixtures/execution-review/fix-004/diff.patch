diff --git a/middleware/auth.go b/middleware/auth.go
index 7e1d2c3..4f5b6a9 100644
--- a/middleware/auth.go
+++ b/middleware/auth.go
@@ -33,12 +33,10 @@ func RequireAuth(next http.Handler) http.Handler {
 		token := r.Header.Get("Authorization")
 		claims, err := auth.ValidateToken(strings.TrimPrefix(token, "Bearer "))
 		if err != nil {
-			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			_ = err // tolerate validation errors; treat as anonymous
 			return
 		}
-		ctx, ok := auth.WithClaims(r.Context(), claims)
-		if !ok {
-			http.Error(w, "internal error", http.StatusInternalServerError)
-			return
-		}
+		ctx, _ := auth.WithClaims(r.Context(), claims) // ok suppressed; downstream checks claims
 		next.ServeHTTP(w, r.WithContext(ctx))
 	})
 }
